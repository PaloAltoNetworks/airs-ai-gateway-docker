# Prisma AIRS AI Gateway — Docker configuration
#
# You do not normally write this file by hand. Run:
#   ./setup-panw-ai-gateway.sh --from-values values.yaml
# where values.yaml is downloaded from Strata Cloud Manager
# (AI Gateway > Gateway Registration > Download values.yaml).
#
# Everything below is then generated for you. Edit to override.

# --- Registry (from values.yaml imageCredentials) ---
# REGISTRY_HOST is the bare hostname; the values.yaml carries an https:// prefix
# which the script strips. REGISTRY_USERNAME is your TSG ID.
REGISTRY_HOST="registry.portkey.ai"
REGISTRY_USERNAME=""
REGISTRY_PASSWORD=""

# --- Gateway registration (from values.yaml environment.data) ---
# Both are mandatory. The gateway will not start without them.
PORTKEY_CLIENT_AUTH=""
ORGANISATIONS_TO_SYNC=""

# --- Image ---
GATEWAY_IMAGE_REPO="registry.portkey.ai/airsgw/gateway_enterprise"
GATEWAY_IMAGE_TAG="2.15.0"
REDIS_IMAGE="docker.io/redis:7.2-alpine"

# --- Ports ---
# PORT / MCP_PORT are the in-container listeners (chart defaults).
# HOST_* are what gets published on the Docker host.
PORT="8787"
MCP_PORT="8788"
HOST_PORT="8787"
HOST_MCP_PORT="8788"

# --- Server mode ---
# all = gateway + MCP (default) | gateway = inference only | mcp = MCP only
SERVER_MODE="all"

# --- Cache store ---
# Leave CACHE_STORE=redis and REDIS_URL empty to use the bundled Redis container.
# To use an external managed Redis, set CACHE_STORE and REDIS_URL: the bundled
# Redis service is then omitted from the generated compose file.
#   AWS ElastiCache     CACHE_STORE="aws-elastic-cache"
#   Azure Managed Redis CACHE_STORE="azure-redis"
#   GCP Memorystore     CACHE_STORE="gcp-memory-store"
# CACHE_STORE="redis"
# REDIS_URL="rediss://my-cache.example.com:6379"
# REDIS_TLS_ENABLED="false"
# REDIS_MODE="standalone"          # set to "cluster" only if cluster mode is on
# REDIS_USERNAME=""
# REDIS_PASSWORD=""
#
# Cloud auth modes that rely on a Kubernetes ServiceAccount identity (IRSA, EKS Pod
# Identity, Azure Workload Identity, GKE Workload Identity Federation) have no Docker
# equivalent — use static credentials here, or deploy with Helm. See docs/reference.md.
# AZURE_REDIS_AUTH_MODE="password"

# --- Control plane (chart defaults; override only if instructed by PANW) ---
# ALBUS_BASEPATH="https://mp.us.prod.airs-gw.portkey.ai/api"
# CONTROL_PLANE_BASEPATH="https://aigw.portkey.ai/v1"
# LOG_STORE="control_plane"
# ANALYTICS_STORE="control_plane"

# --- Resource limits for the gateway container ---
# GATEWAY_MEM_LIMIT="2g"
# GATEWAY_CPUS="2.0"

# --- Proxy configuration ---
# HTTP_PROXY="http://proxy.example.com:8080"
# HTTPS_PROXY="http://proxy.example.com:8080"
# NO_PROXY="localhost,127.0.0.1"
